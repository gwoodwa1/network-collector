<config xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <configuration xmlns="http://xml.juniper.net/xnm/1.1/xnm">
    <interfaces>
      <interface>
        <name>{{access_port}}</name>
        <unit nc:operation="remove">
          <name>{{access_unit}}</name>
        </unit>
      </interface>
    </interfaces>
    <routing-instances>
      <instance nc:operation="remove">
        <name>{{l2vpn_name}}</name>
      </instance>
    </routing-instances>
  </configuration>
</config>
